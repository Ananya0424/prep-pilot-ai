# Database connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/preppilot

# JWT Secret for Auth sessions
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# LLM Provider configuration
# Supported: gemini, openai, groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional crawler configuration
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_MS=8000
